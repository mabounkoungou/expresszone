WOO_TIMEOUT_MS_BATCH=30000

QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=1200

# Woo sync batching + stuck detection
WOO_PRODUCTS_PER_JOB=2
WOO_SYNC_STUCK_SECONDS=600
WOO_SYNC_QUEUE_WAIT_SECONDS=1800

# Woo API retries (transient failures only)
WOO_HTTP_RETRIES=2
WOO_HTTP_RETRY_BASE_MS=300
WOO_MAX_CONSECUTIVE_FAILURES=7

# WP media (big images on shared hosting)
WOO_WP_MEDIA_SEARCH_TIMEOUT=15
WOO_WP_MEDIA_UPLOAD_TIMEOUT=240
WOO_WP_MEDIA_RETRIES=2
WOO_WP_MEDIA_RETRY_SLEEP_MS=500

WOO_STOCK_PRODUCTS_PER_JOB=3
WOO_POLL_TICK_MAX_SECONDS=300
WOO_WP_MEDIA_UPLOAD_TIMEOUT=240

WOO_REMOTE_INDEX_PAGE_CAP=500
WOO_SKU_SEARCH_PAGE_CAP=10

WOO_ALLOW_ALT_SKU_ON_LOOKUP_CONFLICT=false

# Accounting V2 (Auto Journal Entries)
